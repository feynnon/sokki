#!/usr/bin/env bash
# sokki: Sokki from the command line on the Mac, for you and for local agents.
#
#   sokki transcribe FILE [--json]   Any audio or video file to text, with Sokki's speech model.
#   sokki ask [PROMPT]               Ask the local language model Sokki uses for summaries.
#                                    Reads stdin too: `cat notes.md | sokki ask "Summarise"`.
#   sokki config [KEY [VALUE]]       List every setting, show one, or change one.
#                                    `sokki config meetings.auto_start_show_after_s 90`
#
# All commands: CLI.md. Every setting: CONFIG.md.
#
# Everything runs on this Mac. On Linux, the `sokki` binary from crates/sokki has
# the same two commands. Install: ln -s "$PWD/scripts/sokki" ~/.local/bin/sokki
#
# Both wait while Sokki records or processes a meeting, so the meeting keeps the Mac.
set -euo pipefail

# The installed app's bundle id and binary, so this works before and after an
# update that renamed them.
INSTALLED_PLIST="/Applications/Sokki.app/Contents/Info.plist"
APP_ID="$(defaults read "$INSTALLED_PLIST" CFBundleIdentifier 2>/dev/null || echo org.sokki.app)"
APP_EXE="$(defaults read "$INSTALLED_PLIST" CFBundleExecutable 2>/dev/null || echo sokki)"
APP_BIN="${SOKKI_APP_BIN:-/Applications/Sokki.app/Contents/MacOS/$APP_EXE}"
SETTINGS="${SOKKI_SETTINGS:-$HOME/Library/Application Support/$APP_ID/settings_store.json}"

usage() {
  sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
}

die() { echo "sokki: $*" >&2; exit 1; }

# While Sokki records or processes a meeting, a transcription or a question to
# the model waits: on 2026-11-24 eight transcriptions started from another
# session ran during a call, and that second the call audio went dead for the
# rest of the meeting; while processing, Sokki runs its own speech and
# language models. SOKKI_MEETINGS_INDEX points elsewhere for tests.
MEETINGS_INDEX="${SOKKI_MEETINGS_INDEX:-$HOME/Library/Application Support/$APP_ID/meetings/index.json}"
WAIT_EVERY="${SOKKI_WAIT_EVERY_S:-10}"
meeting_busy() {
  [ -f "$MEETINGS_INDEX" ] || return 1
  python3 - "$MEETINGS_INDEX" <<'PY' 2>/dev/null
import json, sys
try:
    data = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
meetings = data if isinstance(data, list) else data.get("meetings", [])
busy = any((m.get("status") or {}).get("kind") in ("recording", "processing") for m in meetings if isinstance(m, dict))
sys.exit(0 if busy else 1)
PY
}
wait_for_meeting() {
  meeting_busy || return 0
  echo "sokki: Sokki is recording or processing a meeting; waiting until it is done…" >&2
  local began=$SECONDS
  while meeting_busy; do
    sleep "$WAIT_EVERY"
  done
  echo "sokki: the meeting is done after $((SECONDS - began)) s; going on." >&2
}

# One setting from Sokki's settings file, or a default.
setting() {
  python3 - "$SETTINGS" "$1" "$2" <<'PY' 2>/dev/null || echo "$3"
import json, sys
path, key, default = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    s = json.load(open(path))["settings"]["meetings"]
    v = s.get(key) or default
except Exception:
    v = default
print(v)
PY
}

transcribe() {
  local file="" json=0
  for a in "$@"; do
    case "$a" in
      --json) json=1 ;;
      -*) die "unknown option $a" ;;
      *) [ -z "$file" ] && file="$a" || die "one file at a time" ;;
    esac
  done
  [ -n "$file" ] || die "usage: sokki transcribe FILE [--json]"
  [ -f "$file" ] || die "no such file: $file"
  [ -x "$APP_BIN" ] || die "Sokki is not installed at ${APP_BIN%/Contents/*}"
  local ffmpeg; ffmpeg="$(command -v ffmpeg || echo /opt/homebrew/bin/ffmpeg)"
  [ -x "$ffmpeg" ] || die "needs ffmpeg: brew install ffmpeg"

  local tmp; tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' RETURN
  "$ffmpeg" -nostdin -hide_banner -loglevel error -i "$file" -vn -ac 1 -ar 16000 -c:a pcm_s16le "$tmp/audio.wav" \
    || die "could not read audio from $file"
  wait_for_meeting
  local out
  out="$("$APP_BIN" --transcribe-file "$tmp/audio.wav" --json 2>"$tmp/log")" \
    || { tail -3 "$tmp/log" >&2; die "transcription failed"; }
  if [ "$json" = 1 ]; then
    printf '%s\n' "$out"
  else
    printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["text"])'
  fi
}

ask() {
  local think=false prompt="" input=""
  local words=()
  for a in "$@"; do
    case "$a" in
      --think) think=true ;;
      *) words+=("$a") ;;
    esac
  done
  prompt="${words[*]:-}"
  if [ ! -t 0 ]; then input="$(cat)"; fi
  if [ -n "$prompt" ] && [ -n "$input" ]; then prompt="$prompt"$'\n\n'"$input"
  elif [ -z "$prompt" ]; then prompt="$input"; fi
  [ -n "$prompt" ] || die "usage: sokki ask PROMPT   (or pipe text in)"

  local base model
  base="$(setting llm_base_url "" "http://localhost:11434")"
  model="${SOKKI_MODEL:-$(setting llm_model "" "qwen3.5:9b")}"
  base="${base%/}"
  wait_for_meeting

  # Same call Sokki makes for summaries: Ollama's /api/chat, thinking off,
  # the model's own temperature. An OpenAI-compatible server (URL ending in /v1)
  # gets /chat/completions instead.
  PROMPT="$prompt" MODEL="$model" BASE="$base" THINK="$think" python3 - <<'PY'
import json, os, sys, urllib.request, urllib.error
base, model, prompt = os.environ["BASE"], os.environ["MODEL"], os.environ["PROMPT"]
think = os.environ["THINK"] == "true"
messages = [{"role": "user", "content": prompt}]
if base.endswith("/v1"):
    url, body = base + "/chat/completions", {"model": model, "messages": messages, "stream": False}
else:
    url, body = base + "/api/chat", {"model": model, "messages": messages, "stream": False, "think": think}
req = urllib.request.Request(url, json.dumps(body).encode(), {"Content-Type": "application/json"})
try:
    with urllib.request.urlopen(req, timeout=600) as r:
        data = json.load(r)
except urllib.error.URLError as e:
    sys.exit(f"sokki: no language model at {base} ({e.reason if hasattr(e, 'reason') else e}). Is Ollama running?")
if "choices" in data:
    text = data["choices"][0]["message"]["content"]
else:
    text = data.get("message", {}).get("content", "")
print(text.strip())
PY
}

# Sokki's settings, read and changed in its settings file. The running app
# applies a change within a second (src-tauri/src/config_watch.rs). Keys are
# dotted paths under "settings" (CONFIG.md lists them). Values are JSON
# (true, 60, "text", ["a","b"]); a bare word counts as text. Only existing
# keys, and only with the type they have, so a typo can't break the file.
# Keys, tokens and passwords never print.
config() {
  [ $# -le 2 ] || die "usage: sokki config [KEY [VALUE]]"
  [ -f "$SETTINGS" ] || die "no settings yet at $SETTINGS (start Sokki once)"
  python3 - "$SETTINGS" "$@" <<'PY'
import json, os, sys, tempfile
path, args = sys.argv[1], sys.argv[2:]
with open(path) as f:
    store = json.load(f)
root = store.get("settings")
if not isinstance(root, dict):
    sys.exit("sokki: the settings file has no settings")

def secret(key):
    k = key.lower()
    return any(w in k for w in ("key", "token", "secret", "password"))

def shown(key, value):
    if secret(key) and value not in (None, "", {}, []):
        return '"(hidden)"'
    return json.dumps(value, ensure_ascii=False)

def flat(prefix, value, out):
    if isinstance(value, dict) and value and not secret(prefix):
        for k in sorted(value):
            flat(f"{prefix}.{k}" if prefix else k, value[k], out)
    else:
        out.append((prefix, value))
    return out

def find(key):
    node = root
    parts = key.split(".")
    for part in parts[:-1]:
        if not isinstance(node, dict) or part not in node:
            return None, None
        node = node[part]
    if not isinstance(node, dict) or parts[-1] not in node:
        return None, None
    return node, parts[-1]

if not args:
    for key, value in flat("", root, []):
        print(f"{key} = {shown(key, value)}")
    sys.exit(0)

key = args[0]
parent, last = find(key)
if parent is None:
    near = [k for k, _ in flat("", root, []) if key.split(".")[-1] in k][:8]
    hint = ("; did you mean: " + ", ".join(near)) if near else ""
    sys.exit(f"sokki: no setting {key}{hint}. `sokki config` lists them all.")
if len(args) == 1:
    print(shown(key, parent[last]))
    sys.exit(0)

raw = args[1]
try:
    value = json.loads(raw)
except json.JSONDecodeError:
    value = raw
old = parent[last]
def kind(v):
    if isinstance(v, bool): return "true or false"
    if isinstance(v, (int, float)): return "a number"
    if isinstance(v, str): return "text"
    if isinstance(v, list): return "a list"
    if isinstance(v, dict): return "an object"
    return "empty"
if old is not None and kind(old) != kind(value):
    if kind(old) == "text" and not isinstance(value, (dict, list)):
        value = raw
    else:
        sys.exit(f"sokki: {key} takes {kind(old)}, not {raw!r}")
if isinstance(old, int) and not isinstance(old, bool) and isinstance(value, float):
    if value != int(value):
        sys.exit(f"sokki: {key} takes a whole number, not {raw!r}")
    value = int(value)
parent[last] = value
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".settings-")
with os.fdopen(fd, "w") as f:
    json.dump(store, f, indent=2, ensure_ascii=False)
os.replace(tmp, path)
print(f"{key} = {shown(key, value)}  (was {shown(key, old)})")
PY
}

case "${1:-}" in
  transcribe) shift; transcribe "$@" ;;
  ask) shift; ask "$@" ;;
  config) shift; config "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command $1 (try: sokki transcribe FILE, sokki ask PROMPT, sokki config)" ;;
esac
