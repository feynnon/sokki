#!/usr/bin/env bash
# sokki: Sokki from the command line. The command is a Rust binary
# (crates/sokki, CLI.md); this script only finds it, so a link from
# ~/.local/bin/sokki to a source checkout keeps working:
#
#   1. $SOKKI_CLI (or $SOKKI_BIN), if set
#   2. the binary inside the installed app (what install.sh links)
#   3. a build in this checkout: target/cli/{release,debug}/sokki, or
#      crates/sokki/target/{release,debug}/sokki
#
# Build one: scripts/build-sokki-cli.sh (release, through the build queue),
# or `cargo build` in crates/sokki.
set -euo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
for bin in \
  "${SOKKI_CLI:-}" \
  "${SOKKI_BIN:-}" \
  "/Applications/Sokki.app/Contents/Resources/resources/bin/sokki" \
  "$REPO/target/cli/release/sokki" \
  "$REPO/crates/sokki/target/release/sokki" \
  "$REPO/target/cli/debug/sokki" \
  "$REPO/crates/sokki/target/debug/sokki"; do
  if [[ -n "$bin" && -x "$bin" ]]; then
    exec "$bin" "$@"
  fi
done
echo "sokki: the sokki binary isn't built yet. Install Sokki (install.sh), or build it: scripts/build-sokki-cli.sh" >&2
exit 1
