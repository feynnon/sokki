        "type": "Spa:String:JSON",
        "value": {
          "name": "Auto-switch restore timeout",
          "description": "How long to wait, in milliseconds, before restoring the previous profile when recording stops",
          "type": "int",
          "default": 4000,
          "min": 0,
          "max": 60000
        }
